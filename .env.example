# 模型配置。
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OpenAI 官方示例：
# LLM_PROVIDER=openai-responses
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=填写服务商密钥
# LLM_MODEL=填写模型名

# OpenAI Chat Completions 兼容接口（如 DeepSeek）：
# LLM_PROVIDER=openai-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=填写 DeepSeek API Key
# LLM_MODEL=填写该接口实际支持的模型名

# Ollama 本机示例：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama-local
# LLM_MODEL=填写已安装的模型名

# 可选：默认保存位置、默认数据库位置、本地数据库路径和上传/分段上限。
PROPHET_THEME=system
PROPHET_TIMEZONE=Asia/Shanghai
PROPHET_OUTPUT_DIR=
PROPHET_DATABASE_DIR=
APP_DB_PATH=data/sentiment.db
FORTUNE_DB_PATH=data/fortune.db
MAX_FILE_MB=20
MAX_TEXT_CHARS=200000
MAX_TABLE_ROWS=10000
MAX_CHUNK_CHARS=12000
CHUNK_OVERLAP_CHARS=300
