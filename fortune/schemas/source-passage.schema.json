{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortune-telling:schema:source-passage:1.0.0",
  "title": "SourcePassage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "work",
    "edition",
    "tradition",
    "hexagramNumber",
    "section",
    "textTraditional",
    "textSimplified",
    "sourceUrl",
    "sourcePage",
    "rights",
    "reviewStatus",
    "checksum"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "work": { "const": "周易" },
    "edition": { "type": "string", "minLength": 1 },
    "tradition": { "const": "zhouyi-textual" },
    "hexagramNumber": { "type": "integer", "minimum": 1, "maximum": 64 },
    "section": {
      "type": "string",
      "enum": ["hexagram-name", "judgement", "tuan", "great-image", "line", "line-image"]
    },
    "line": { "type": "integer", "minimum": 1, "maximum": 6 },
    "textTraditional": { "type": "string", "minLength": 1 },
    "textSimplified": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "pattern": "^https://" },
    "sourcePage": { "type": "string", "minLength": 1 },
    "rights": { "$ref": "#/$defs/rightsInfo" },
    "reviewStatus": {
      "type": "string",
      "enum": ["unreviewed", "single-checked", "double-checked", "corrected", "blocked"]
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "section": { "enum": ["line", "line-image"] }
        }
      },
      "then": { "required": ["line"] }
    },
    {
      "if": {
        "properties": {
          "section": { "enum": ["hexagram-name", "judgement", "tuan", "great-image"] }
        }
      },
      "then": { "not": { "required": ["line"] } }
    }
  ],
  "$defs": {
    "rightsInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textStatus", "attribution"],
      "properties": {
        "textStatus": {
          "type": "string",
          "enum": ["public-domain-original", "licensed-transcription", "rights-review-required"]
        },
        "transcriptionLicense": { "const": "CC-BY-SA-4.0" },
        "attribution": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "pattern": "^https://" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
