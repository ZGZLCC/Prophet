{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fortune-telling:schema:liuren-facts:1.0.0",
  "title": "LiurenFacts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engineId", "time", "monthGeneral", "earthPlate", "heavenlyPlate", "generals", "lessons", "decisionTrace", "transmissions", "course", "specialPatterns", "derivation", "ruleHits", "readingPolicy", "ruleProfile", "engineVersion"],
  "properties": {
    "schemaVersion": { "const": "fortune-liuren-facts.v1" },
    "engineId": { "const": "liuren" },
    "time": { "type": "object" },
    "monthGeneral": { "type": "object", "required": ["branch", "sourceTerm", "placement", "ruleId"] },
    "earthPlate": { "type": "array", "minItems": 12, "maxItems": 12 },
    "heavenlyPlate": { "type": "array", "minItems": 12, "maxItems": 12 },
    "generals": { "type": "array", "minItems": 12, "maxItems": 12 },
    "lessons": { "type": "array", "minItems": 4, "maxItems": 4 },
    "decisionTrace": { "type": "array", "minItems": 9 },
    "transmissions": { "type": "array", "minItems": 3, "maxItems": 3 },
    "course": { "type": "object" },
    "specialPatterns": { "type": "object" },
    "derivation": { "type": "array", "minItems": 10 },
    "ruleHits": { "type": "array", "minItems": 10 },
    "readingPolicy": { "const": "liuren-shijia-analysis-v1" },
    "ruleProfile": { "const": "liuren-shijia-jiuzong-v1" },
    "engineVersion": { "const": "0.9.0" }
  }
}
